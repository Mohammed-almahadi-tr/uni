<?xml version="1.0" standalone="yes"?>
<xs:schema id="DsTrans" targetNamespace="http://www.tempuri.org/DsTrans.xsd" xmlns:mstns="http://www.tempuri.org/DsTrans.xsd" xmlns="http://www.tempuri.org/DsTrans.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" attributeFormDefault="qualified" elementFormDefault="qualified">
  <xs:element name="DsTrans" msdata:IsDataSet="true">
    <xs:complexType>
      <xs:choice maxOccurs="unbounded">
        <xs:element name="Transactions">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="TransNO" msdata:ReadOnly="true" msdata:AutoIncrement="true" type="xs:long" />
              <xs:element name="TransType" type="xs:string" minOccurs="0" />
              <xs:element name="SNO" type="xs:long" minOccurs="0" />
              <xs:element name="Source" type="xs:string" minOccurs="0" />
              <xs:element name="Descr" type="xs:string" minOccurs="0" />
              <xs:element name="Package" type="xs:string" minOccurs="0" />
              <xs:element name="Acc" type="xs:string" minOccurs="0" />
              <xs:element name="SubAcc" type="xs:string" minOccurs="0" />
              <xs:element name="TotalValueIn" type="xs:double" minOccurs="0" />
              <xs:element name="TotalValueOut" type="xs:double" minOccurs="0" />
              <xs:element name="Writting" type="xs:string" minOccurs="0" />
              <xs:element name="TransDate" type="xs:dateTime" minOccurs="0" />
              <xs:element name="Done" type="xs:int" minOccurs="0" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:complexType>
    <xs:unique name="Constraint1" msdata:PrimaryKey="true">
      <xs:selector xpath=".//mstns:Transactions" />
      <xs:field xpath="mstns:TransNO" />
    </xs:unique>
  </xs:element>
</xs:schema>