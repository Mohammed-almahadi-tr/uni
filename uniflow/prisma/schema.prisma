// UniFlow — Phase 0 schema: ledger invariants and platform spine.
//
// Scope note: this covers only what the Phase 0 gate requires (SRS Modules 5,
// 11 and 12). Students, fees, cashiering, assets and procurement land in
// Tracks A and B and are deliberately absent here.
//
// Two rules govern this file:
//   1. Every monetary column is Decimal(19,4). Never Float. (Plan decision 4)
//   2. Constraints that guarantee correctness live in SQL migrations, not
//      here — Prisma cannot express deferred constraint triggers, RLS
//      policies or CHECKs. See prisma/sql/invariants.sql.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 moved connection URLs out of the schema. Migrations read
  // DIRECT_URL from prisma.config.ts; the runtime client is handed a pg
  // adapter built from DATABASE_URL. On Supabase those are different
  // endpoints and are not interchangeable — see .env.example.
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PeriodStatus {
  FUTURE
  OPEN
  CLOSED
  PERMANENTLY_CLOSED
}

enum FiscalYearStatus {
  FUTURE
  OPEN
  CLOSED
  PERMANENTLY_CLOSED
}

enum NormalBalance {
  DEBIT
  CREDIT
}

/// Sub-ledger a control-account line points into. A line on a control account
/// must carry both a type and an id — enforced by CHECK in SQL.
enum SubledgerType {
  STUDENT
  SPONSOR
  VENDOR
}

/// Structural roles an account can play for a tenant. Modules ask for the
/// role, never for a hardcoded account code — a tenant may renumber its chart.
enum AccountRole {
  STUDENT_AR_CONTROL
  STUDENT_CREDIT_CONTROL
  SPONSOR_AR_CONTROL
  VENDOR_AP_CONTROL
  DEFAULT_CASH
  DEFAULT_BANK
  /// Cheques in the vault, not yet presented.
  CHEQUES_RECEIVABLE
  /// Cheques deposited with the bank for collection. Separate from the vault
  /// account so "what is in our safe" and "what is with the bank" are two
  /// figures the ledger can answer rather than one.
  CHEQUES_WITH_BANK
  DEFAULT_DISCOUNT_EXPENSE
  /// Where gain or loss on disposing of a fixed asset lands.
  ASSET_DISPOSAL_GAIN_LOSS
  /// Goods received not invoiced. Holds the obligation between the moment
  /// something arrives and the moment its bill does, so the expense keeps the
  /// date it was incurred rather than the date it was paid.
  GRNI_ACCRUAL
  FX_REALISED
  FX_UNREALISED
  RETAINED_SURPLUS
}

/// How often a fee item is billed. Drives the fee matrix and the recognition
/// schedule, not the accounting.
enum FeeRecurrence {
  PER_TERM
  PER_YEAR
  ONE_OFF
}

/// How money arrived (SRS REQ-CSH-01). CREDIT_BALANCE is not a payment — it is
/// the application of an existing overpayment to a new charge, and it moves
/// nothing into the institution.
enum PaymentChannel {
  CASH
  BANK_TRANSFER
  CHEQUE
  GATEWAY
  CREDIT_BALANCE
}

/// SRS Module 14. Track B owns the transitions; the states are declared here
/// because the sub-ledger has to know whether a student is still liable.
/// SRS REQ-CHQ-02. Each value has its own meaning and its own ledger
/// consequence. A cheque that has not been presented yet is NOT in the same
/// state as one the bank refused — the legacy system conflated the two into a
/// single boolean, so every uncleared cheque displayed as "Rejected".
enum JobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// SRS REQ-AST-02. Straight line is the default; reducing balance exists
/// because it is what the legacy system did by accident — it multiplied an
/// account's *current balance* by a percentage — and a tenant carrying that
/// policy forward should be able to say so rather than have it happen to them.
enum DepreciationMethod {
  STRAIGHT_LINE
  REDUCING_BALANCE
  /// Land, and anything else that does not depreciate.
  NONE
}

enum AssetStatus {
  IN_SERVICE
  /// Sold or scrapped. Cost and accumulated depreciation are off the books.
  DISPOSED
  /// Written off with no proceeds.
  WRITTEN_OFF
}

enum ChequeStatus {
  /// In hand, not yet deposited.
  RECEIVED
  /// Deposited for collection.
  SENT_TO_BANK
  /// The bank paid it.
  CLEARED
  /// The bank refused it.
  BOUNCED
  /// Returned to the drawer before presentation.
  CANCELLED
}

/// Physical location of the paper, which is a different question from its
/// status: a cheque can be RECEIVED and in the vault, or BOUNCED and back with
/// the drawer.
enum ChequeCustody {
  VAULT
  WITH_BANK
  RETURNED_TO_DRAWER
  /// Presented and paid; the paper no longer matters.
  SETTLED
}

enum StudentStatus {
  APPLICANT
  ADMITTED
  ACTIVE
  DEFERRED
  SUSPENDED
  WITHDRAWN
  DISMISSED
  TRANSFERRED_OUT
  GRADUATED
  ALUMNUS
}

/// SRS REQ-BDG-01. A budget is a *version*, not a set of rows that get edited.
/// The legacy `AccBudget` had neither versions nor an approval: a row was
/// inserted, and revision meant soft-deleting it and inserting another.
enum BudgetStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  /// Replaced by a later approved version. Kept, so last year's original
  /// budget is still readable next to the revised one.
  SUPERSEDED
}

/// What "available" is measured against (SRS REQ-BDG-02).
enum BudgetControlBasis {
  /// The whole year's allocation is available from day one. Simple, and right
  /// for institutions that do not phase their spending.
  ANNUAL
  /// Only the allocation for periods up to and including the document's own
  /// period is available. Stops a department spending the year in January.
  CUMULATIVE_TO_PERIOD
}

/// What happens when a commitment would exceed the line (SRS REQ-BDG-02).
/// Per line, because a hard stop on stationery and a hard stop on emergency
/// building repairs are not the same decision.
enum BudgetPolicy {
  /// Recorded and reported, never blocked.
  ADVISORY
  /// Allowed, but the caller is told and the overrun is recorded.
  WARN
  /// Refused.
  BLOCK
}

/// SRS REQ-PRC-03. A partially released encumbrance stays OPEN — the live
/// commitment is `amount - released_amount`, so there is no separate partial
/// state to keep in step with the arithmetic.
enum EncumbranceStatus {
  OPEN
  RELEASED
  CANCELLED
  /// Expired at year-end under a tenant policy of "use it or lose it".
  LAPSED
  /// Rolled into the next fiscal year's budget.
  CARRIED_FORWARD
}

enum EncumbranceAction {
  RESERVE
  RELEASE
  CANCEL
  LAPSE
  CARRY_FORWARD
}

enum RequisitionState {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  /// Turned into a purchase order. Never edited afterwards.
  CONVERTED
  CANCELLED
}

enum PurchaseOrderState {
  DRAFT
  PENDING_APPROVAL
  /// Approved, and the encumbrance exists from this moment.
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  /// Finished with. Any unreceived remainder released its encumbrance.
  CLOSED
  CANCELLED
}

/// SRS REQ-PRC-04. An invoice that fails the three-way match is not rejected —
/// it is held, because most failures are a price change somebody authorised
/// verbally and nobody wrote down.
enum VendorInvoiceState {
  /// Matched within tolerance and posted.
  MATCHED
  /// Outside tolerance, unposted, waiting for exception approval.
  ON_HOLD
  /// Released by exception approval and posted.
  APPROVED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentVoucherState {
  DRAFT
  PENDING_APPROVAL
  /// Approved and posted in the same act — approval is what releases money.
  PAID
  REJECTED
  CANCELLED
}

/// Dual authorisation on vendor bank details (SRS REQ-PRC-01).
enum BankChangeState {
  PENDING
  APPROVED
  REJECTED
}

/// Non-ledger documents that still need their own gapless numbering.
enum ProcurementDocType {
  REQUISITION
  PURCHASE_ORDER
  GOODS_RECEIPT
  VENDOR_INVOICE
  PAYMENT_VOUCHER
}

enum VoucherType {
  JOURNAL
  STUDENT_RECEIPT
  /// Raising fee charges on a student account. Distinct from REGISTRATION so
  /// that a library fine does not appear in registration reporting.
  STUDENT_CHARGE
  GENERAL_RECEIPT
  PAYMENT
  REGISTRATION
  DEPRECIATION
  REVENUE_RECOGNITION
  CHEQUE_MOVEMENT
  /// Accrual raised when goods or services are received.
  GOODS_RECEIPT
  /// The vendor's bill, moving the accrual to a formal payable.
  VENDOR_INVOICE
  FX_REVALUATION
  OPENING_BALANCE
  REVERSAL
  YEAR_END_CLOSE
}

/// Which module originated a posting. Every ledger entry is traceable to the
/// business event that caused it — the legacy system's registration and
/// finance modules were reconciled by hand precisely because this was absent.
enum SourceModule {
  MANUAL
  REGISTRATION
  CASHIERING
  CHEQUES
  FIXED_ASSETS
  REVENUE_RECOGNITION
  PROCUREMENT
  PERIOD_CLOSE
  ONBOARDING
}

enum DraftState {
  DRAFT
  PENDING_REVIEW
  PENDING_APPROVAL
  POSTED
  REJECTED
  /// Abandoned by its maker before review. Distinct from REJECTED, which is a
  /// checker's verdict and carries their comment. Neither is ever deleted.
  CANCELLED
}

enum AuditAction {
  INSERT
  UPDATE
  DELETE
  APPROVE
  REJECT
  REVERSE
  POST
  LOGIN
  PERIOD_OPEN
  PERIOD_CLOSE
}

// ---------------------------------------------------------------------------
// Platform & security
// ---------------------------------------------------------------------------

model Tenant {
  id                   String   @id @default(uuid()) @db.Uuid
  slug                 String   @unique
  nameEn               String   @map("name_en")
  nameAr               String   @map("name_ar")
  logoUrl              String?  @map("logo_url")
  themeConfig          Json?    @map("theme_config")
  /// The currency the books are kept in. Every balance check and every
  /// statement is expressed in this currency.
  functionalCurrency   String   @default("SDG") @map("functional_currency") @db.Char(3)
  fiscalYearStartMonth Int      @default(1) @map("fiscal_year_start_month") @db.SmallInt
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users           User[]
  roles           Role[]
  fiscalYears     FiscalYear[]
  accounts        Account[]
  costCenters     CostCenter[]
  headers         TransactionHeader[]
  sequences       DocumentSequence[]
  auditEntries    AuditLog[]
  idempotencyKeys IdempotencyKey[]
  exchangeRates   ExchangeRate[]
  periodBalances  AccountPeriodBalance[]
  voucherDrafts   VoucherDraft[]
  draftSequences  DraftSequence[]
  attachments     VoucherAttachment[]

  accountMappings AccountMapping[]
  cashierTills    CashierTill[]
  feeItems        FeeItem[]
  students        Student[]
  studentCharges  StudentCharge[]
  studentReceipts StudentReceipt[]
  allocations     ReceiptAllocation[]
  recognitions    RecognitionEntry[]
  instalmentPlans InstalmentPlan[]
  cheques         Cheque[]
  chequeEvents    ChequeEvent[]
  jobRuns         JobRun[]
  assetCategories AssetCategory[]
  assets          FixedAsset[]
  depreciation    DepreciationEntry[]
  assetMovements  AssetMovement[]

  budgets              Budget[]
  budgetLines          BudgetLine[]
  budgetAllocations    BudgetPeriodAllocation[]
  encumbrances         Encumbrance[]
  encumbranceMovements EncumbranceMovement[]
  vendors              Vendor[]
  vendorBankChanges    VendorBankChange[]
  procurementSequences ProcurementSequence[]
  requisitions         PurchaseRequisition[]
  requisitionLines     RequisitionLine[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceipts        GoodsReceipt[]
  goodsReceiptLines    GoodsReceiptLine[]
  vendorInvoices       VendorInvoice[]
  vendorInvoiceLines   VendorInvoiceLine[]
  paymentVouchers      PaymentVoucher[]
  paymentAllocations   PaymentAllocation[]

  faculties           Faculty[]
  departments         Department[]
  programmes          Programme[]
  academicYears       AcademicYear[]
  academicTerms       AcademicTerm[]
  batches             Batch[]
  admissionCategories AdmissionCategory[]
  nationalities       Nationality[]
  feeSchedules        FeeSchedule[]
  feeScheduleLines    FeeScheduleLine[]

  certificateTypes   CertificateType[]
  seatQuotas         SeatQuota[]
  eligibilityRules   EligibilityRule[]
  applications       Application[]
  applicationChoices ApplicationChoice[]
  admissionOffers    AdmissionOffer[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  fullName     String   @map("full_name")
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // ---- Second factor (SRS REQ-NFR-05) ----
  /// Base32 TOTP secret. A bearer credential — encrypt at rest.
  mfaSecret     String?   @map("mfa_secret")
  /// Null until a generated code has been verified. A scanned-but-unconfirmed
  /// secret must not gate approvals, or a mistyped scan locks the approver out.
  mfaEnrolledAt DateTime? @map("mfa_enrolled_at") @db.Timestamptz(6)
  /// Last accepted TOTP time step. Refusing to reuse a step stops a code that
  /// was shoulder-surfed at a shared approval desk from being replayed inside
  /// its 30-second window.
  mfaLastStep   BigInt?   @map("mfa_last_step")

  // ---- Session and lockout ----
  /// Bumped whenever roles change or the password is reset. A live session
  /// carrying an older version is rejected at its next request, so revoking
  /// access takes effect immediately rather than at token expiry.
  sessionVersion   Int       @default(1) @map("session_version")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles         UserRole[]
  postedHeaders TransactionHeader[] @relation("PostedBy")
  auditEntries  AuditLog[]
  recoveryCodes RecoveryCode[]
  attachments   VoucherAttachment[]

  till                CashierTill?
  receiptsTaken       StudentReceipt[] @relation("ReceiptCashier")
  receiptsCancelled   StudentReceipt[] @relation("ReceiptCanceller")
  chargesRaised       StudentCharge[]  @relation("ChargeCreator")
  plansCreated        InstalmentPlan[] @relation("PlanCreator")
  chequesTaken        Cheque[]         @relation("ChequeCreator")
  receiptsDishonoured StudentReceipt[] @relation("ReceiptDishonourer")
  jobsRequested       JobRun[]         @relation("JobRequester")
  assetsRegistered    FixedAsset[]     @relation("AssetCreator")
  assetsHeld          FixedAsset[]     @relation("AssetCustodian")

  feeSchedulesPrepared FeeSchedule[] @relation("FeeSchedulePreparer")
  feeSchedulesApproved FeeSchedule[] @relation("FeeScheduleApprover")

  seatQuotasCreated    SeatQuota[]      @relation("SeatQuotaCreator")
  applicationsDecided  Application[]    @relation("ApplicationDecider")
  offersIssued         AdmissionOffer[] @relation("OfferIssuer")
  offersOverridden     AdmissionOffer[] @relation("OfferOverrider")

  budgetsPrepared     Budget[]              @relation("BudgetPreparer")
  budgetsApproved     Budget[]              @relation("BudgetApprover")
  vendorsCreated      Vendor[]              @relation("VendorCreator")
  bankChangesRaised   VendorBankChange[]    @relation("BankChangeRequester")
  bankChangesDecided  VendorBankChange[]    @relation("BankChangeApprover")
  requisitionsRaised  PurchaseRequisition[] @relation("RequisitionRequester")
  requisitionsDecided PurchaseRequisition[] @relation("RequisitionApprover")
  ordersCreated       PurchaseOrder[]       @relation("OrderCreator")
  ordersApproved      PurchaseOrder[]       @relation("OrderApprover")
  goodsReceived       GoodsReceipt[]        @relation("ReceiptReceiver")
  invoicesRecorded    VendorInvoice[]       @relation("InvoiceCreator")
  invoicesApproved    VendorInvoice[]       @relation("InvoiceApprover")
  paymentsDrafted     PaymentVoucher[]      @relation("PaymentCreator")
  paymentsApproved    PaymentVoucher[]      @relation("PaymentApprover")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// Single-use codes for the phone that was lost or reset. Stored hashed,
/// exactly as passwords are — a recovery code bypasses the second factor, so
/// storing them in clear would quietly undo the control.
model RecoveryCode {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model Role {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String
  nameAr   String @map("name_ar")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  /// Dotted resource.action, e.g. "voucher.approve", "period.close".
  key         String @id
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Append-only, hash-chained. Each entry carries the hash of its predecessor
/// within the tenant, so removal or alteration of any entry breaks the chain
/// and is detected by the verification job. UPDATE and DELETE are blocked by
/// trigger (SRS REQ-ADM-03).
model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  /// Monotonic per tenant. Gaps mean tampering.
  seq          BigInt
  actorId      String?     @map("actor_id") @db.Uuid
  ip           String?
  occurredAt   DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  action       AuditAction
  resourceType String      @map("resource_type")
  resourceId   String      @map("resource_id")
  beforeJson   Json?       @map("before_json")
  afterJson    Json?       @map("after_json")
  prevHash     String      @map("prev_hash")
  hash         String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@unique([tenantId, seq])
  @@index([tenantId, resourceType, resourceId])
  @@map("audit_log")
}

/// Guarantees that a replayed financial request creates at most one record.
/// A cashier double-pressing Save on a slow link is the expected condition at
/// these campuses, not the exceptional one (SRS REQ-NFR-07).
model IdempotencyKey {
  key          String    @db.VarChar(255)
  tenantId     String    @map("tenant_id") @db.Uuid
  endpoint     String
  /// SHA-256 of the canonicalised request body. Same key + different body is
  /// an error, not a replay.
  requestHash  String    @map("request_hash")
  responseJson Json?     @map("response_json")
  /// NULL until the operation completes — an in-flight duplicate is rejected
  /// rather than served a partial result.
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// Voucher numbering. Allocation takes a row lock; MAX(n)+1 is prohibited.
/// The legacy system used MAX(n)+1 everywhere, and its fixed-asset module
/// omitted the year filter the other call sites applied, so its numbers
/// collided with prior years (SRS REQ-FIN-06).
model DocumentSequence {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  fiscalYearId String      @map("fiscal_year_id") @db.Uuid
  docType      VoucherType @map("doc_type")
  nextValue    Int         @default(1) @map("next_value")
  prefix       String      @default("")
  padding      Int         @default(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fiscalYearId, docType])
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// Fiscal calendar (SRS Module 12)
// ---------------------------------------------------------------------------

model FiscalYear {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  name      String
  startDate DateTime         @map("start_date") @db.Date
  endDate   DateTime         @map("end_date") @db.Date
  status    FiscalYearStatus @default(FUTURE)

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periods        FiscalPeriod[]
  sequences      DocumentSequence[]
  headers        TransactionHeader[]
  drafts         VoucherDraft[]
  draftSequences DraftSequence[]

  budgets              Budget[]
  encumbrances         Encumbrance[]
  procurementSequences ProcurementSequence[]
  requisitions         PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]

  @@unique([tenantId, name])
  @@index([tenantId, startDate])
  @@map("fiscal_years")
}

model FiscalPeriod {
  id           String       @id @default(uuid()) @db.Uuid
  fiscalYearId String       @map("fiscal_year_id") @db.Uuid
  seq          Int
  startDate    DateTime     @map("start_date") @db.Date
  endDate      DateTime     @map("end_date") @db.Date
  status       PeriodStatus @default(FUTURE)
  closedAt     DateTime?    @map("closed_at") @db.Timestamptz(6)
  closedById   String?      @map("closed_by_id") @db.Uuid

  fiscalYear        FiscalYear               @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  headers           TransactionHeader[]
  balances          AccountPeriodBalance[]
  recognitions      RecognitionEntry[]
  depreciation      DepreciationEntry[]
  budgetAllocations BudgetPeriodAllocation[]

  @@unique([fiscalYearId, seq])
  @@index([fiscalYearId, startDate, endDate])
  @@map("fiscal_periods")
}

// ---------------------------------------------------------------------------
// Chart of accounts (SRS Module 5)
// ---------------------------------------------------------------------------

model Account {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  code     String
  nameAr   String  @map("name_ar")
  nameEn   String  @map("name_en")
  /// 1 Major Class · 2 Group · 3 Sub-Group · 4 Parent · 5 Detail.
  level    Int     @db.SmallInt
  parentId String? @map("parent_id") @db.Uuid

  normalBalance      NormalBalance  @map("normal_balance")
  /// Only level-5 accounts may receive postings. Levels 1-4 aggregate.
  isPostable         Boolean        @default(false) @map("is_postable")
  /// Control accounts (Student AR, Sponsor AR, Vendor AP) accept postings
  /// only with sub-ledger identity attached, so the sub-ledger and the
  /// control account cannot silently diverge.
  isControlAccount   Boolean        @default(false) @map("is_control_account")
  subledgerType      SubledgerType? @map("subledger_type")
  requiresCostCenter Boolean        @default(false) @map("requires_cost_center")
  isActive           Boolean        @default(true) @map("is_active")

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Account?               @relation("AccountTree", fields: [parentId], references: [id])
  children Account[]              @relation("AccountTree")
  lines    TransactionLine[]
  balances AccountPeriodBalance[]

  mappings            AccountMapping[]
  tills               CashierTill[]    @relation("TillCashAccount")
  feeRevenueFor       FeeItem[]        @relation("FeeRevenueAccount")
  feeUnearnedFor      FeeItem[]        @relation("FeeUnearnedAccount")
  receiptDebits       StudentReceipt[] @relation("ReceiptDebitAccount")
  chequeDeposits      Cheque[]         @relation("ChequeDepositAccount")
  categoryAsset       AssetCategory[]  @relation("CategoryAssetAccount")
  categoryAccumulated AssetCategory[]  @relation("CategoryAccumulatedAccount")
  categoryExpense     AssetCategory[]  @relation("CategoryExpenseAccount")

  budgetLines        BudgetLine[]        @relation("BudgetLineAccount")
  requisitionLines   RequisitionLine[]   @relation("RequisitionLineAccount")
  orderLines         PurchaseOrderLine[] @relation("OrderLineAccount")
  vendorInvoiceLines VendorInvoiceLine[] @relation("InvoiceLineAccount")
  paymentsFrom       PaymentVoucher[]    @relation("PaymentBankAccount")

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@index([tenantId, level])
  @@map("chart_of_accounts")
}

model CostCenter {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  code     String
  nameAr   String  @map("name_ar")
  nameEn   String  @map("name_en")
  isActive Boolean @default(true) @map("is_active")

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines    TransactionLine[]
  balances AccountPeriodBalance[]
  feeItems FeeItem[]
  assets   FixedAsset[]           @relation("AssetCostCenter")

  faculties          Faculty[]             @relation("FacultyCostCentre")
  budgetLines        BudgetLine[]          @relation("BudgetLineCostCenter")
  requisitions       PurchaseRequisition[] @relation("RequisitionCostCenter")
  requisitionLines   RequisitionLine[]     @relation("RequisitionLineCostCenter")
  orderLines         PurchaseOrderLine[]   @relation("OrderLineCostCenter")
  vendorInvoiceLines VendorInvoiceLine[]   @relation("InvoiceLineCostCenter")

  @@unique([tenantId, code])
  @@map("cost_centers")
}

// ---------------------------------------------------------------------------
// General ledger (SRS Module 5)
// ---------------------------------------------------------------------------

/// Maker-checker staging. Unlike the legacy TempVouchers table, a draft is
/// NEVER deleted on approval — deleting it destroyed the only evidence the
/// voucher had been reviewed (SRS REQ-FIN-04).
model VoucherDraft {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  draftNo     String      @map("draft_no")
  voucherType VoucherType @map("voucher_type")
  docDate     DateTime    @map("doc_date") @db.Date
  description String
  state       DraftState  @default(DRAFT)
  /// The proposed lines, exactly as the maker entered them. Frozen by trigger
  /// once the draft leaves DRAFT/REJECTED: a maker who could edit the lines
  /// after review would have defeated the whole control.
  linesJson   Json        @map("lines_json")

  /// Fiscal year of docDate, resolved when the draft is saved. Carried so the
  /// work queue can filter by year without touching the period table, and so
  /// the draft number series is per year.
  fiscalYearId String  @map("fiscal_year_id") @db.Uuid
  /// Denormalised total (debits) so a work-queue listing does not have to
  /// parse linesJson for every row. Recomputed on every save.
  totalAmount  Decimal @default(0) @map("total_amount") @db.Decimal(19, 4)

  sourceModule SourceModule @default(MANUAL) @map("source_module")
  sourceRef    String?      @map("source_ref")

  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  postedHeaderId String?  @unique @map("posted_header_id") @db.Uuid

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear  FiscalYear          @relation(fields: [fiscalYearId], references: [id])
  events      ApprovalEvent[]
  attachments VoucherAttachment[]
  posted      TransactionHeader?  @relation(fields: [postedHeaderId], references: [id])

  @@unique([tenantId, draftNo])
  @@index([tenantId, state])
  @@index([tenantId, createdById, state])
  @@map("voucher_drafts")
}

/// Draft numbering, per tenant x fiscal year.
///
/// Deliberately a different series from `document_sequences`: a draft number
/// identifies a proposal, a voucher number identifies a statutory document.
/// Sharing one counter would burn voucher numbers on drafts that are never
/// approved, and an auditor asking why receipt 41 does not exist deserves a
/// better answer than "someone changed their mind".
model DraftSequence {
  tenantId     String @map("tenant_id") @db.Uuid
  fiscalYearId String @map("fiscal_year_id") @db.Uuid
  nextValue    Int    @default(1) @map("next_value")
  prefix       String @default("DFT-")
  padding      Int    @default(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@id([tenantId, fiscalYearId])
  @@map("draft_sequences")
}

/// Supporting evidence for a draft — the supplier invoice, the bank advice,
/// the signed request. Only the metadata lives here; the bytes live in object
/// storage under `storageKey`.
///
/// Attachable only while the draft is editable, and frozen by the same trigger
/// that freezes the lines. A checker approves what they were shown.
model VoucherAttachment {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  draftId     String @map("draft_id") @db.Uuid
  fileName    String @map("file_name")
  contentType String @map("content_type")
  byteSize    Int    @map("byte_size")
  /// Object-storage path. Unique, so two rows can never claim the same blob.
  storageKey  String @unique @map("storage_key")
  /// Content digest, recorded at upload. Lets a later audit prove the file
  /// served today is the file the checker approved.
  sha256      String @db.Char(64)

  uploadedById String   @map("uploaded_by_id") @db.Uuid
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  draft      VoucherDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  uploadedBy User         @relation(fields: [uploadedById], references: [id])

  @@index([draftId])
  @@map("voucher_attachments")
}

/// Every state transition, including rejections and their mandatory comments.
model ApprovalEvent {
  id         String     @id @default(uuid()) @db.Uuid
  draftId    String     @map("draft_id") @db.Uuid
  fromState  DraftState @map("from_state")
  toState    DraftState @map("to_state")
  actorId    String     @map("actor_id") @db.Uuid
  comment    String?
  occurredAt DateTime   @default(now()) @map("occurred_at") @db.Timestamptz(6)

  draft VoucherDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, occurredAt])
  @@map("approval_events")
}

model TransactionHeader {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  fiscalYearId   String      @map("fiscal_year_id") @db.Uuid
  fiscalPeriodId String      @map("fiscal_period_id") @db.Uuid
  voucherType    VoucherType @map("voucher_type")
  /// Allocated from DocumentSequence under a row lock. Unique per tenant ×
  /// fiscal year × voucher type.
  voucherNo      Int         @map("voucher_no")
  voucherRef     String      @map("voucher_ref")
  /// The business date of the document. Determines the fiscal period.
  docDate        DateTime    @map("doc_date") @db.Date
  /// When it actually hit the ledger. Differs from docDate on back-dated entries.
  postingDate    DateTime    @default(now()) @map("posting_date") @db.Timestamptz(6)
  description    String

  sourceModule SourceModule @default(MANUAL) @map("source_module")
  /// Identifier of the originating business record (registration id, receipt
  /// id, asset id …) so any ledger entry can be traced back to its cause.
  sourceRef    String?      @map("source_ref")

  currency       String    @db.Char(3)
  totalAmount    Decimal   @map("total_amount") @db.Decimal(19, 4)
  postedById     String?   @map("posted_by_id") @db.Uuid
  postedAt       DateTime  @default(now()) @map("posted_at") @db.Timestamptz(6)
  isOpeningEntry Boolean   @default(false) @map("is_opening_entry")
  /// Set when this voucher has been reversed. Denormalised from reversedBy so
  /// that "is this live?" does not need a join.
  reversedAt     DateTime? @map("reversed_at") @db.Timestamptz(6)
  /// The voucher this one reverses. UNIQUE, so a voucher is reversed at most
  /// once (SRS REQ-FIN-05).
  reversesId     String?   @unique @map("reverses_id") @db.Uuid
  reversalReason String?   @map("reversal_reason")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear         @relation(fields: [fiscalYearId], references: [id])
  fiscalPeriod FiscalPeriod       @relation(fields: [fiscalPeriodId], references: [id])
  postedBy     User?              @relation("PostedBy", fields: [postedById], references: [id])
  reverses     TransactionHeader? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy   TransactionHeader? @relation("Reversal")
  lines        TransactionLine[]
  draft        VoucherDraft?

  chargesRaised        StudentCharge[]     @relation("ChargePosting")
  chargesReversed      StudentCharge[]     @relation("ChargeReversalPosting")
  studentReceipt       StudentReceipt?     @relation("ReceiptPosting")
  receiptCancellation  StudentReceipt?     @relation("ReceiptCancellationPosting")
  recognitions         RecognitionEntry[]  @relation("RecognitionPosting")
  chequeEvents         ChequeEvent[]       @relation("ChequeEventPosting")
  receiptDishonours    StudentReceipt[]    @relation("ReceiptDishonourPosting")
  assetCapitalisations FixedAsset[]        @relation("AssetCapitalisation")
  assetDisposal        FixedAsset?         @relation("AssetDisposal")
  depreciationEntries  DepreciationEntry[] @relation("DepreciationPosting")

  goodsReceipt        GoodsReceipt?   @relation("GoodsReceiptPosting")
  vendorInvoice       VendorInvoice?  @relation("InvoicePosting")
  invoiceCancellation VendorInvoice?  @relation("InvoiceCancellationPosting")
  paymentVoucher      PaymentVoucher? @relation("PaymentPosting")

  @@unique([tenantId, fiscalYearId, voucherType, voucherNo])
  @@index([tenantId, docDate])
  @@index([tenantId, fiscalPeriodId])
  @@index([tenantId, sourceModule, sourceRef])
  @@map("transaction_headers")
}

model TransactionLine {
  id           String  @id @default(uuid()) @db.Uuid
  headerId     String  @map("header_id") @db.Uuid
  lineNo       Int     @map("line_no")
  accountId    String  @map("account_id") @db.Uuid
  costCenterId String? @map("cost_center_id") @db.Uuid

  subledgerType SubledgerType? @map("subledger_type")
  subledgerId   String?        @map("subledger_id")

  /// Currency the transaction was entered in.
  txnCurrency String  @map("txn_currency") @db.Char(3)
  txnAmount   Decimal @map("txn_amount") @db.Decimal(19, 4)
  fxRate      Decimal @default(1) @map("fx_rate") @db.Decimal(19, 8)

  /// Functional-currency amounts. The balance check applies to THESE.
  debitAmount  Decimal @default(0) @map("debit_amount") @db.Decimal(19, 4)
  creditAmount Decimal @default(0) @map("credit_amount") @db.Decimal(19, 4)
  lineDescr    String? @map("line_descr")

  header     TransactionHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)
  account    Account           @relation(fields: [accountId], references: [id])
  costCenter CostCenter?       @relation(fields: [costCenterId], references: [id])

  @@unique([headerId, lineNo])
  @@index([accountId])
  @@index([subledgerType, subledgerId])
  @@map("transaction_lines")
}

/// Maintained incrementally as vouchers post. Reports read from here; the SRS
/// forbids ad-hoc SUM() over the ledger in report paths, which is what makes
/// REQ-NFR-02 (<100ms at 1M lines) achievable.
model AccountPeriodBalance {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  costCenterId   String? @map("cost_center_id") @db.Uuid
  fiscalPeriodId String  @map("fiscal_period_id") @db.Uuid

  openingDebit   Decimal @default(0) @map("opening_debit") @db.Decimal(19, 4)
  openingCredit  Decimal @default(0) @map("opening_credit") @db.Decimal(19, 4)
  movementDebit  Decimal @default(0) @map("movement_debit") @db.Decimal(19, 4)
  movementCredit Decimal @default(0) @map("movement_credit") @db.Decimal(19, 4)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id])
  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Cascade)

  // NULLS NOT DISTINCT is applied in SQL so that a null cost centre collapses
  // to one row rather than many — see the invariants migration.
  @@unique([tenantId, accountId, costCenterId, fiscalPeriodId])
  @@index([tenantId, fiscalPeriodId])
  @@map("account_period_balances")
}

model ExchangeRate {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  fromCurrency String   @map("from_currency") @db.Char(3)
  toCurrency   String   @map("to_currency") @db.Char(3)
  rateDate     DateTime @map("rate_date") @db.Date
  rate         Decimal  @db.Decimal(19, 8)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromCurrency, toCurrency, rateDate])
  @@map("exchange_rates")
}

// ---------------------------------------------------------------------------
// Fee catalog, student sub-ledger and cashiering (SRS Modules 6 and 13,
// Track A3)
// ---------------------------------------------------------------------------

/// Which account plays a given structural role for a tenant.
///
/// The cashiering, cheque, depreciation and year-end modules all need to know
/// "the student AR control account" without hardcoding a code. A tenant may
/// renumber its chart; it may not have two student control accounts. This is
/// where that is stated once.
model AccountMapping {
  tenantId  String      @map("tenant_id") @db.Uuid
  role      AccountRole
  accountId String      @map("account_id") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@id([tenantId, role])
  @@map("account_mappings")
}

/// The cashier's own safe.
///
/// REQ-CSH-01: a cash receipt posts to the account assigned to the cashier who
/// took it, not to a single shared till. Without this, "which cashier is short
/// at the end of the day" is not answerable from the ledger — which is exactly
/// the question the legacy `IncomeListByCollecter` report was written to ask,
/// and it had to reconstruct the answer from a name column.
model CashierTill {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  userId        String  @unique @map("user_id") @db.Uuid
  cashAccountId String  @map("cash_account_id") @db.Uuid
  isActive      Boolean @default(true) @map("is_active")

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashAccount Account @relation("TillCashAccount", fields: [cashAccountId], references: [id])

  @@index([tenantId])
  @@map("cashier_tills")
}

/// A billable item (SRS REQ-FEE-01).
///
/// The legacy cashier screen hardcoded exactly two grid rows — tuition and
/// registration — and wrote the English literals "Current Assets", "Debtors"
/// and "Students Fees" into a database whose account tree is in Arabic. Real
/// institutions bill eight to twelve heads, each to its own revenue account.
model FeeItem {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  nameAr   String @map("name_ar")
  nameEn   String @map("name_en")

  /// Where the earned revenue lands.
  revenueAccountId  String  @map("revenue_account_id") @db.Uuid
  /// Where the billed-but-unearned amount sits until recognised. Required when
  /// the item is deferrable; enforced by CHECK.
  unearnedAccountId String? @map("unearned_account_id") @db.Uuid
  /// Default cost centre for charges of this item. The tuition account in the
  /// shipped chart requires one.
  costCenterId      String? @map("cost_center_id") @db.Uuid

  /// Billing credits unearned income and revenue is recognised across the
  /// term. The legacy system recognised a full year on registration day.
  isDeferrable   Boolean @default(false) @map("is_deferrable")
  isDiscountable Boolean @default(true) @map("is_discountable")
  isRefundable   Boolean @default(true) @map("is_refundable")
  isTaxable      Boolean @default(false) @map("is_taxable")

  recurrence    FeeRecurrence @default(PER_TERM)
  /// Catalogue price. The fee matrix (Track B) overrides it per programme and
  /// batch; this is what an ad-hoc charge defaults to.
  defaultAmount Decimal?      @map("default_amount") @db.Decimal(19, 4)
  sortOrder     Int           @default(0) @map("sort_order")
  isActive      Boolean       @default(true) @map("is_active")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  revenueAccount  Account         @relation("FeeRevenueAccount", fields: [revenueAccountId], references: [id])
  unearnedAccount Account?        @relation("FeeUnearnedAccount", fields: [unearnedAccountId], references: [id])
  costCenter      CostCenter?     @relation(fields: [costCenterId], references: [id])
  charges         StudentCharge[]
  scheduleLines   FeeScheduleLine[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive, sortOrder])
  @@map("fee_items")
}

/// The finance-facing slice of a student.
///
/// Track B owns the full profile — programme, batch, contact, documents,
/// photograph, medical record. This model exists now because A3 is on the
/// critical path and a cashier cannot take money from a student the system
/// has never heard of. Track B extends this table rather than replacing it;
/// the sub-ledger attaches by `id`.
model Student {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  studentNo  String  @map("student_no")
  fullNameAr String  @map("full_name_ar")
  fullNameEn String  @map("full_name_en")
  /// Alef/hamza/taa-marbuta-normalised name, for search (REQ-ST-03). Written
  /// by the application, never by hand.
  searchKey  String  @map("search_key")
  nationalId String? @map("national_id")

  status     StudentStatus @default(ACTIVE)
  admittedOn DateTime?     @map("admitted_on") @db.Date
  isActive   Boolean       @default(true) @map("is_active")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  /// The four dimensions the fee matrix is keyed on (REQ-AC-04). Nullable
  /// because A3 created students before Track B existed and a cashier must
  /// still be able to take money from them; B3 makes them mandatory for new
  /// admissions. Registration (B4) refuses a student missing any of them —
  /// there is no schedule to bill against.
  programmeId         String? @map("programme_id") @db.Uuid
  batchId             String? @map("batch_id") @db.Uuid
  admissionCategoryId String? @map("admission_category_id") @db.Uuid
  nationalityId       String? @map("nationality_id") @db.Uuid

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programme         Programme?         @relation(fields: [programmeId], references: [id])
  batch             Batch?             @relation(fields: [batchId], references: [id])
  admissionCategory AdmissionCategory? @relation(fields: [admissionCategoryId], references: [id])
  nationality       Nationality?       @relation(fields: [nationalityId], references: [id])
  charges           StudentCharge[]
  receipts          StudentReceipt[]
  plans             InstalmentPlan[]
  application       Application?       @relation("ApplicationStudent")

  @@unique([tenantId, studentNo])
  @@index([tenantId, searchKey])
  @@index([tenantId, status])
  @@index([tenantId, programmeId, batchId])
  @@map("students")
}

/// One billed fee item on one student's account.
///
/// The sub-ledger. Its total across live charges, less what has been settled,
/// must equal the Student AR control account balance to the cent — asserted by
/// test, because the legacy system had no control account and its student
/// balances drifted from the ledger with nothing able to detect it.
model StudentCharge {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  feeItemId String @map("fee_item_id") @db.Uuid

  /// Free text until Track B owns terms — "2026/1", "Spring 2026".
  termLabel String?   @map("term_label")
  docDate   DateTime  @map("doc_date") @db.Date
  dueDate   DateTime? @map("due_date") @db.Date

  /// Catalogue price before any discount.
  grossAmount    Decimal @map("gross_amount") @db.Decimal(19, 4)
  /// Scholarship or staff-child discount. Held as an expense, not netted off
  /// revenue, so discount exposure is reportable on its own line.
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(19, 4)
  /// What the student owes: gross − discount.
  netAmount      Decimal @map("net_amount") @db.Decimal(19, 4)
  /// Maintained as receipts allocate against it. Never exceeds netAmount.
  settledAmount  Decimal @default(0) @map("settled_amount") @db.Decimal(19, 4)

  /// True when billing credited unearned income rather than revenue.
  isDeferred       Boolean @default(false) @map("is_deferred")
  recognisedAmount Decimal @default(0) @map("recognised_amount") @db.Decimal(19, 4)

  currency String @db.Char(3)

  /// The voucher that raised it. Several charges share one voucher when a
  /// term is billed in a single document.
  postedHeaderId   String    @map("posted_header_id") @db.Uuid
  reversedAt       DateTime? @map("reversed_at") @db.Timestamptz(6)
  reversalHeaderId String?   @map("reversal_header_id") @db.Uuid
  reversalReason   String?   @map("reversal_reason")

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeItem      FeeItem             @relation(fields: [feeItemId], references: [id])
  posting      TransactionHeader   @relation("ChargePosting", fields: [postedHeaderId], references: [id])
  reversal     TransactionHeader?  @relation("ChargeReversalPosting", fields: [reversalHeaderId], references: [id])
  createdBy    User                @relation("ChargeCreator", fields: [createdById], references: [id])
  allocations  ReceiptAllocation[]
  recognitions RecognitionEntry[]

  @@index([tenantId, studentId, reversedAt])
  @@index([tenantId, dueDate])
  @@map("student_charges")
}

/// Money taken from a student (SRS REQ-CSH-01).
///
/// The highest-risk duplicate-creation path in the product: a cashier on an
/// unreliable link presses Save twice. Every call carries an idempotency key.
model StudentReceipt {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  /// The allocated voucher reference — the number printed on the paper the
  /// student walks away with.
  receiptNo String         @map("receipt_no")
  docDate   DateTime       @map("doc_date") @db.Date
  channel   PaymentChannel
  amount    Decimal        @db.Decimal(19, 4)
  currency  String         @db.Char(3)

  /// Cash safe, bank account, or cheques-receivable — whichever the channel
  /// debits.
  debitAccountId String @map("debit_account_id") @db.Uuid

  /// Bank slip number, transfer reference or gateway payment id.
  reference String?

  // ---- Cheque detail (channel = CHEQUE). Feeds the Module 7 pipeline. ----
  chequeNo      String?   @map("cheque_no")
  chequeBank    String?   @map("cheque_bank")
  chequeBranch  String?   @map("cheque_branch")
  chequeDueDate DateTime? @map("cheque_due_date") @db.Date
  drawerName    String?   @map("drawer_name")

  /// How much of `amount` has been matched to charges. The remainder is the
  /// student's credit balance.
  allocatedAmount Decimal @default(0) @map("allocated_amount") @db.Decimal(19, 4)

  postedHeaderId String @unique @map("posted_header_id") @db.Uuid

  cancelledAt          DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledById        String?   @map("cancelled_by_id") @db.Uuid
  cancellationReason   String?   @map("cancellation_reason")
  cancellationHeaderId String?   @unique @map("cancellation_header_id") @db.Uuid

  /// Set when the cheque behind this receipt was refused by the bank. Not a
  /// cancellation: the cashier did nothing wrong and the receipt was validly
  /// issued. But the money never arrived, so the receipt stops counting
  /// towards what the student has paid.
  dishonouredAt     DateTime? @map("dishonoured_at") @db.Timestamptz(6)
  dishonouredById   String?   @map("dishonoured_by_id") @db.Uuid
  dishonourHeaderId String?   @unique @map("dishonour_header_id") @db.Uuid

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student          Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  debitAccount     Account             @relation("ReceiptDebitAccount", fields: [debitAccountId], references: [id])
  posting          TransactionHeader   @relation("ReceiptPosting", fields: [postedHeaderId], references: [id])
  cancellationPost TransactionHeader?  @relation("ReceiptCancellationPosting", fields: [cancellationHeaderId], references: [id])
  cashier          User                @relation("ReceiptCashier", fields: [createdById], references: [id])
  cancelledBy      User?               @relation("ReceiptCanceller", fields: [cancelledById], references: [id])
  dishonouredBy    User?               @relation("ReceiptDishonourer", fields: [dishonouredById], references: [id])
  dishonourPost    TransactionHeader?  @relation("ReceiptDishonourPosting", fields: [dishonourHeaderId], references: [id])
  cheque           Cheque?
  allocations      ReceiptAllocation[]
  seatDepositFor   AdmissionOffer[]    @relation("OfferDepositReceipt")

  @@unique([tenantId, receiptNo])
  @@index([tenantId, studentId])
  @@index([tenantId, docDate, createdById])
  @@map("student_receipts")
}

/// Which receipt paid which charge.
///
/// Sub-ledger detail with no general-ledger effect of its own: the receipt
/// already credited AR when it was taken. This is what makes aging and
/// "which charges are still outstanding" answerable, and it is what a student
/// disputing their balance is shown.
model ReceiptAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  receiptId String   @map("receipt_id") @db.Uuid
  chargeId  String   @map("charge_id") @db.Uuid
  amount    Decimal  @db.Decimal(19, 4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipt StudentReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  charge  StudentCharge  @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@unique([receiptId, chargeId])
  @@index([chargeId])
  @@map("receipt_allocations")
}

/// One period's slice of a deferred charge (SRS REQ-FEE-02).
///
/// Written when the charge is raised, posted by the period-end batch. Holding
/// the whole schedule up front means the batch is a lookup rather than a
/// calculation, and re-running it cannot produce a different answer.
model RecognitionEntry {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  chargeId       String  @map("charge_id") @db.Uuid
  fiscalPeriodId String  @map("fiscal_period_id") @db.Uuid
  amount         Decimal @db.Decimal(19, 4)

  recognisedAt   DateTime? @map("recognised_at") @db.Timestamptz(6)
  postedHeaderId String?   @map("posted_header_id") @db.Uuid

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charge       StudentCharge      @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  fiscalPeriod FiscalPeriod       @relation(fields: [fiscalPeriodId], references: [id])
  posting      TransactionHeader? @relation("RecognitionPosting", fields: [postedHeaderId], references: [id])

  @@unique([chargeId, fiscalPeriodId])
  @@index([tenantId, fiscalPeriodId, recognisedAt])
  @@map("recognition_entries")
}

/// A payment schedule over a term's charges (SRS REQ-CSH-02).
///
/// The legacy equivalent was a `ChkBoPrem` checkbox that wrote a `Remain`
/// balance and a `PaymentStatus` flag onto the registration row — no dates, no
/// instalment records, and therefore no way to say what was overdue.
model InstalmentPlan {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  termLabel   String?  @map("term_label")
  totalAmount Decimal  @map("total_amount") @db.Decimal(19, 4)
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("PlanCreator", fields: [createdById], references: [id])
  instalments Instalment[]

  @@index([tenantId, studentId])
  @@map("instalment_plans")
}

model Instalment {
  id      String   @id @default(uuid()) @db.Uuid
  planId  String   @map("plan_id") @db.Uuid
  seq     Int
  dueDate DateTime @map("due_date") @db.Date
  amount  Decimal  @db.Decimal(19, 4)

  plan InstalmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, seq])
  @@index([dueDate])
  @@map("instalments")
}

// ---------------------------------------------------------------------------
// Cheque portfolio and clearing pipeline (SRS Module 7, Track A4)
// ---------------------------------------------------------------------------

/// A cheque taken in payment (SRS REQ-CHQ-01).
///
/// The legacy system had no cheque entity at all. A cheque was a `CheqClear`
/// **boolean** on the `Transactions` row, toggled by clicking a grid cell,
/// which issued `UPDATE Transactions SET CheqClear=1` and posted nothing.
/// Three consequences, all of them live in production:
///
///   · 0 rendered as "Rejected", and 0 was also the initial value, so every
///     cheque that had simply not been presented yet displayed as bounced;
///   · clearing a cheque never moved the bank balance, because there was no
///     ledger entry;
///   · a bounced cheque never reinstated the student's debt, so a student
///     whose cheque was refused still showed as paid.
model Cheque {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  chequeNo   String   @map("cheque_no")
  bankName   String?  @map("bank_name")
  branch     String?
  drawerName String?  @map("drawer_name")
  /// Normalised drawer identity, for repeat-bounce reporting (REQ-CHQ-03).
  drawerKey  String   @map("drawer_key")
  dueDate    DateTime @map("due_date") @db.Date
  amount     Decimal  @db.Decimal(19, 4)
  currency   String   @db.Char(3)

  /// Who the cheque came from. A cheque is always somebody's promise.
  subledgerType SubledgerType @map("subledger_type")
  subledgerId   String        @map("subledger_id")

  status  ChequeStatus  @default(RECEIVED)
  custody ChequeCustody @default(VAULT)

  /// The receipt this cheque paid for, when it came in over the counter.
  /// Null for a cheque registered directly against a sponsor.
  receiptId String? @unique @map("receipt_id") @db.Uuid

  /// Bank account it was deposited to, once sent for collection.
  depositAccountId String? @map("deposit_account_id") @db.Uuid

  receivedOn   DateTime  @map("received_on") @db.Date
  sentToBankOn DateTime? @map("sent_to_bank_on") @db.Date
  settledOn    DateTime? @map("settled_on") @db.Date

  /// The bank's refusal code and words, kept verbatim (REQ-CHQ-03).
  bounceReasonCode String? @map("bounce_reason_code")
  bounceReason     String? @map("bounce_reason")

  /// A replacement handed over after this one was refused.
  replacesChequeId String? @unique @map("replaces_cheque_id") @db.Uuid

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipt        StudentReceipt? @relation(fields: [receiptId], references: [id])
  depositAccount Account?        @relation("ChequeDepositAccount", fields: [depositAccountId], references: [id])
  replaces       Cheque?         @relation("ChequeReplacement", fields: [replacesChequeId], references: [id])
  replacedBy     Cheque?         @relation("ChequeReplacement")
  createdBy      User            @relation("ChequeCreator", fields: [createdById], references: [id])
  events         ChequeEvent[]

  @@unique([tenantId, chequeNo, drawerKey])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, drawerKey])
  @@index([tenantId, subledgerType, subledgerId])
  @@map("cheques")
}

/// Every transition, with the voucher it posted.
///
/// Append-only. The legacy grid let you click "Cleared" and then "Rejected"
/// on the same row all afternoon, leaving only the last click behind.
model ChequeEvent {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  chequeId   String       @map("cheque_id") @db.Uuid
  fromStatus ChequeStatus @map("from_status")
  toStatus   ChequeStatus @map("to_status")
  /// Business date of the transition — the date on the bank advice, not the
  /// day somebody got round to keying it.
  docDate    DateTime     @map("doc_date") @db.Date
  reasonCode String?      @map("reason_code")
  comment    String?
  actorId    String       @map("actor_id") @db.Uuid
  occurredAt DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)

  /// The voucher this transition posted. Null only for transitions that move
  /// no money, of which there are none today.
  postedHeaderId String? @map("posted_header_id") @db.Uuid

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cheque  Cheque             @relation(fields: [chequeId], references: [id], onDelete: Cascade)
  posting TransactionHeader? @relation("ChequeEventPosting", fields: [postedHeaderId], references: [id])

  @@index([chequeId, occurredAt])
  @@index([tenantId, toStatus, docDate])
  @@map("cheque_events")
}

// ---------------------------------------------------------------------------
// Durable job runs (Track A5)
// ---------------------------------------------------------------------------

/// One invocation of a period-end batch.
///
/// Two things the idempotency-key table cannot give: a *visible* record of when
/// depreciation was last run and by whom, and a place for a failed run to
/// leave its error so somebody can act on it. The legacy depreciation screen
/// had neither — clicking Save twice posted twice, and there was nowhere to
/// look afterwards to find out that it had.
model JobRun {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// What kind of batch: "depreciation", "revenue-recognition", "dunning".
  jobType String @map("job_type")
  /// The natural key of this particular run — normally the period it covers.
  /// Unique per tenant, which is what makes a repeat invocation a replay.
  jobKey  String @map("job_key")

  status     JobStatus @default(RUNNING)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  /// The result of the successful run, replayed verbatim to a retry.
  resultJson Json?   @map("result_json")
  /// Why it failed, kept so a failure is diagnosable after the fact.
  errorText  String? @map("error_text")
  /// How many attempts it has taken. A number above one is worth looking at.
  attempts   Int     @default(1)

  requestedById String @map("requested_by_id") @db.Uuid

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("JobRequester", fields: [requestedById], references: [id])

  @@unique([tenantId, jobKey])
  @@index([tenantId, jobType, startedAt])
  @@map("job_runs")
}

// ---------------------------------------------------------------------------
// Fixed assets (SRS Module 9, Track A5)
// ---------------------------------------------------------------------------

/// A class of asset and the three accounts its postings use.
///
/// The legacy system had no asset entity at all: an "asset" was a row in the
/// chart of accounts (`Acc` with `Acc1 = 'Fixed Assets'`) carrying a
/// `DeprPerc` column. There was no purchase date, no in-service date, no
/// salvage value, no useful life, no serial number, no custodian and no
/// location — and no accumulated-depreciation account, so net book value was
/// not derivable.
model AssetCategory {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  nameAr   String @map("name_ar")
  nameEn   String @map("name_en")

  /// Where cost sits.
  assetAccountId       String @map("asset_account_id") @db.Uuid
  /// The contra-asset that accumulates the charge.
  accumulatedAccountId String @map("accumulated_account_id") @db.Uuid
  /// Where the periodic charge is expensed.
  expenseAccountId     String @map("expense_account_id") @db.Uuid

  defaultMethod           DepreciationMethod @default(STRAIGHT_LINE) @map("default_method")
  defaultUsefulLifeMonths Int                @map("default_useful_life_months")
  /// Salvage as a fraction of cost, e.g. 0.05 for 5%. Overridable per asset.
  defaultSalvageRate      Decimal            @default(0) @map("default_salvage_rate") @db.Decimal(9, 6)
  isActive                Boolean            @default(true) @map("is_active")

  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetAccount       Account      @relation("CategoryAssetAccount", fields: [assetAccountId], references: [id])
  accumulatedAccount Account      @relation("CategoryAccumulatedAccount", fields: [accumulatedAccountId], references: [id])
  expenseAccount     Account      @relation("CategoryExpenseAccount", fields: [expenseAccountId], references: [id])
  assets             FixedAsset[]

  @@unique([tenantId, code])
  @@map("asset_categories")
}

model FixedAsset {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  assetCode  String  @map("asset_code")
  barcode    String?
  serialNo   String? @map("serial_no")
  categoryId String  @map("category_id") @db.Uuid

  nameAr String @map("name_ar")
  nameEn String @map("name_en")

  purchaseDate  DateTime @map("purchase_date") @db.Date
  /// When it started being used, which is when depreciation starts — not the
  /// day it was bought. A lab bench delivered in June and installed in
  /// September depreciates from September.
  inServiceDate DateTime @map("in_service_date") @db.Date
  purchaseCost  Decimal  @map("purchase_cost") @db.Decimal(19, 4)
  salvageValue  Decimal  @default(0) @map("salvage_value") @db.Decimal(19, 4)
  currency      String   @db.Char(3)

  method           DepreciationMethod @default(STRAIGHT_LINE)
  usefulLifeMonths Int                @map("useful_life_months")

  /// Where the periodic charge is expensed to. The shipped depreciation
  /// expense account requires one.
  costCenterId String? @map("cost_center_id") @db.Uuid
  location     String?
  custodianId  String? @map("custodian_id") @db.Uuid

  status AssetStatus @default(IN_SERVICE)

  /// The voucher that brought the asset onto the books.
  capitalisationHeaderId String @map("capitalisation_header_id") @db.Uuid

  disposedOn       DateTime? @map("disposed_on") @db.Date
  disposalProceeds Decimal?  @map("disposal_proceeds") @db.Decimal(19, 4)
  disposalReason   String?   @map("disposal_reason")
  disposalHeaderId String?   @unique @map("disposal_header_id") @db.Uuid

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       AssetCategory       @relation(fields: [categoryId], references: [id])
  costCenter     CostCenter?         @relation("AssetCostCenter", fields: [costCenterId], references: [id])
  custodian      User?               @relation("AssetCustodian", fields: [custodianId], references: [id])
  createdBy      User                @relation("AssetCreator", fields: [createdById], references: [id])
  capitalisation TransactionHeader   @relation("AssetCapitalisation", fields: [capitalisationHeaderId], references: [id])
  disposal       TransactionHeader?  @relation("AssetDisposal", fields: [disposalHeaderId], references: [id])
  schedule       DepreciationEntry[]
  movements      AssetMovement[]

  @@unique([tenantId, assetCode])
  @@index([tenantId, status, categoryId])
  @@index([tenantId, custodianId])
  @@map("fixed_assets")
}

/// One period's planned charge for one asset (SRS REQ-AST-02).
///
/// Generated at capitalisation, posted by the period-end batch. Accumulated
/// depreciation and net book value are derived from posted rows, never
/// recomputed — the legacy screen multiplied the account's *current balance*
/// by a percentage every time it was opened, which is reducing-balance by
/// accident and never terminates.
model DepreciationEntry {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  assetId        String  @map("asset_id") @db.Uuid
  fiscalPeriodId String  @map("fiscal_period_id") @db.Uuid
  seq            Int
  amount         Decimal @db.Decimal(19, 4)

  postedAt       DateTime? @map("posted_at") @db.Timestamptz(6)
  postedHeaderId String?   @map("posted_header_id") @db.Uuid

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset        FixedAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fiscalPeriod FiscalPeriod       @relation(fields: [fiscalPeriodId], references: [id])
  posting      TransactionHeader? @relation("DepreciationPosting", fields: [postedHeaderId], references: [id])

  @@unique([assetId, fiscalPeriodId])
  @@index([tenantId, fiscalPeriodId, postedAt])
  @@map("depreciation_entries")
}

/// Custodian and location history (SRS REQ-AST-04).
///
/// Who had it and where it was, retained. An asset register that only knows
/// where something is now cannot answer the question a physical count asks.
model AssetMovement {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  assetId  String @map("asset_id") @db.Uuid

  fromLocation    String? @map("from_location")
  toLocation      String? @map("to_location")
  fromCustodianId String? @map("from_custodian_id") @db.Uuid
  toCustodianId   String? @map("to_custodian_id") @db.Uuid

  movedOn    DateTime @map("moved_on") @db.Date
  reason     String?
  actorId    String   @map("actor_id") @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset  FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, occurredAt])
  @@map("asset_movements")
}

// ---------------------------------------------------------------------------
// Budget (SRS Module 8, Track A6)
//
// The legacy `AccBudget` table keyed a budget line on four *text* account
// names (Acc1..Acc4) over a free-form date range, with no uniqueness and no
// link to the fiscal calendar. Two rows for the same account silently doubled
// the budget; renaming an account orphaned its budget with nothing able to
// detect it; and the periods were whatever dates the clerk picked, stamped
// with a literal " 10:10:10" so they would sort inside the report's
// "00:00:01".."23:59:59" window.
//
// It was also advisory in the strongest sense: nothing anywhere consulted it.
// `frmBudget` was a report you looked at *after* you had overspent.
// ---------------------------------------------------------------------------

model Budget {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  fiscalYearId String @map("fiscal_year_id") @db.Uuid
  /// 1 is the original; every revision is a new version, never an edit.
  versionNo    Int    @map("version_no")
  label        String

  status       BudgetStatus       @default(DRAFT)
  controlBasis BudgetControlBasis @default(ANNUAL) @map("control_basis")

  preparedById String    @map("prepared_by_id") @db.Uuid
  preparedAt   DateTime  @default(now()) @map("prepared_at") @db.Timestamptz(6)
  submittedAt  DateTime? @map("submitted_at") @db.Timestamptz(6)
  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  decisionNote String?   @map("decision_note")
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  preparedBy User         @relation("BudgetPreparer", fields: [preparedById], references: [id])
  approvedBy User?        @relation("BudgetApprover", fields: [approvedById], references: [id])
  lines      BudgetLine[]

  @@unique([tenantId, fiscalYearId, versionNo])
  @@index([tenantId, fiscalYearId, status])
  @@map("budgets")
}

/// One account × cost centre allocation within a budget version.
///
/// Referenced by id rather than by name, which is the whole difference from
/// the legacy design: the chart can be renamed, translated or renumbered and
/// the budget still points at the same account.
model BudgetLine {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  budgetId     String  @map("budget_id") @db.Uuid
  accountId    String  @map("account_id") @db.Uuid
  costCenterId String? @map("cost_center_id") @db.Uuid

  annualAmount Decimal      @map("annual_amount") @db.Decimal(19, 4)
  policy       BudgetPolicy @default(BLOCK)
  note         String?

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budget       Budget                   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account      Account                  @relation("BudgetLineAccount", fields: [accountId], references: [id])
  costCenter   CostCenter?              @relation("BudgetLineCostCenter", fields: [costCenterId], references: [id])
  periods      BudgetPeriodAllocation[]
  encumbrances Encumbrance[]
  poLines      PurchaseOrderLine[]

  @@index([tenantId, budgetId])
  @@index([tenantId, accountId])
  @@map("budget_lines")
}

/// The monthly or quarterly phasing of a budget line (SRS REQ-BDG-01).
///
/// Always written, whatever the control basis, because variance reporting
/// wants to know what was *planned* for March even when availability is
/// checked against the year.
model BudgetPeriodAllocation {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  budgetLineId   String  @map("budget_line_id") @db.Uuid
  fiscalPeriodId String  @map("fiscal_period_id") @db.Uuid
  amount         Decimal @db.Decimal(19, 4)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budgetLine   BudgetLine   @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id])

  @@unique([budgetLineId, fiscalPeriodId])
  @@index([tenantId, fiscalPeriodId])
  @@map("budget_period_allocations")
}

/// A commitment reserved against a budget line by an approved purchase order
/// (SRS REQ-PRC-03).
///
/// Deliberately NOT a general-ledger posting. An encumbrance is a claim on
/// spending authority, not a transaction: no asset has been acquired and no
/// liability incurred. Posting it would put amounts in the trial balance that
/// no accounting standard recognises, and every statement would then need a
/// rule for excluding them again. It reduces *available budget* and nothing
/// else.
model Encumbrance {
  id                  String @id @default(uuid()) @db.Uuid
  tenantId            String @map("tenant_id") @db.Uuid
  budgetLineId        String @map("budget_line_id") @db.Uuid
  purchaseOrderId     String @map("purchase_order_id") @db.Uuid
  purchaseOrderLineId String @unique @map("purchase_order_line_id") @db.Uuid
  fiscalYearId        String @map("fiscal_year_id") @db.Uuid

  amount         Decimal           @db.Decimal(19, 4)
  /// Converted to an actual by a goods receipt, or given back by a
  /// cancellation. Never exceeds `amount`.
  releasedAmount Decimal           @default(0) @map("released_amount") @db.Decimal(19, 4)
  status         EncumbranceStatus @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budgetLine    BudgetLine            @relation(fields: [budgetLineId], references: [id])
  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  poLine        PurchaseOrderLine     @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  fiscalYear    FiscalYear            @relation(fields: [fiscalYearId], references: [id])
  movements     EncumbranceMovement[]

  @@index([tenantId, budgetLineId, status])
  @@index([tenantId, fiscalYearId, status])
  @@map("encumbrances")
}

/// Append-only history of what reserved, released or cancelled a commitment.
///
/// Without it, `released_amount` is a number with no explanation, and "why is
/// this order still committing 40,000 we no longer expect to spend" has no
/// answer.
model EncumbranceMovement {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  encumbranceId  String            @map("encumbrance_id") @db.Uuid
  action         EncumbranceAction
  amount         Decimal           @db.Decimal(19, 4)
  reason         String?
  /// The receipt that converted the commitment into an actual, when that is
  /// what caused the movement.
  goodsReceiptId String?           @map("goods_receipt_id") @db.Uuid

  actorId    String   @map("actor_id") @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encumbrance  Encumbrance   @relation(fields: [encumbranceId], references: [id], onDelete: Cascade)
  goodsReceipt GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])

  @@index([encumbranceId, occurredAt])
  @@map("encumbrance_movements")
}

// ---------------------------------------------------------------------------
// Procurement and accounts payable (SRS Module 16, Track A6)
//
// Entirely new. The legacy system had no vendor, no purchase order, no goods
// receipt and no invoice: `frmMakePayBill` posted a grid of expense lines
// against cash in one step, at payment time. An expense incurred in March and
// paid in June was reported in June.
// ---------------------------------------------------------------------------

model Vendor {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  nameAr   String @map("name_ar")
  nameEn   String @map("name_en")

  taxRegistrationNo String? @map("tax_registration_no")
  category          String?
  contactName       String? @map("contact_name")
  phone             String?
  email             String?
  address           String?
  /// Days from invoice date to due date, used to default the due date.
  paymentTermsDays  Int     @default(30) @map("payment_terms_days")

  /// Bank details change only through `vendor_bank_changes`, which needs a
  /// second person. Redirecting a legitimate vendor's payments to an attacker
  /// account is the highest-value fraud in accounts payable, and it needs no
  /// fake invoice — only an edit to this row.
  bankName        String? @map("bank_name")
  bankAccountName String? @map("bank_account_name")
  bankAccountNo   String? @map("bank_account_no")
  bankIban        String? @map("bank_iban")

  isActive    Boolean @default(true) @map("is_active")
  isBlocked   Boolean @default(false) @map("is_blocked")
  blockReason String? @map("block_reason")

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("VendorCreator", fields: [createdById], references: [id])
  bankChanges VendorBankChange[]
  orders      PurchaseOrder[]
  invoices    VendorInvoice[]
  payments    PaymentVoucher[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("vendors")
}

/// A proposed change to a vendor's bank details, awaiting a second person
/// (SRS REQ-PRC-01, REQ-SOD-01).
model VendorBankChange {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  vendorId String @map("vendor_id") @db.Uuid

  proposedBankName        String? @map("proposed_bank_name")
  proposedBankAccountName String? @map("proposed_bank_account_name")
  proposedBankAccountNo   String? @map("proposed_bank_account_no")
  proposedBankIban        String? @map("proposed_bank_iban")
  /// What was there before, so the approver can see what is actually
  /// changing rather than only what it is changing to.
  previousJson            Json?   @map("previous_json")

  state  BankChangeState @default(PENDING)
  reason String

  requestedById String    @map("requested_by_id") @db.Uuid
  requestedAt   DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedById   String?   @map("decided_by_id") @db.Uuid
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?   @map("decision_note")

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor      Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("BankChangeRequester", fields: [requestedById], references: [id])
  decidedBy   User?  @relation("BankChangeApprover", fields: [decidedById], references: [id])

  @@index([tenantId, vendorId, state])
  @@map("vendor_bank_changes")
}

/// Numbering for documents that are not ledger vouchers.
///
/// Separate from `document_sequences` for the same reason drafts are: a
/// requisition that is rejected must not burn a statutory voucher number.
model ProcurementSequence {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  fiscalYearId String             @map("fiscal_year_id") @db.Uuid
  docType      ProcurementDocType @map("doc_type")
  nextValue    Int                @default(1) @map("next_value")
  prefix       String             @default("")
  padding      Int                @default(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fiscalYearId, docType])
  @@map("procurement_sequences")
}

model PurchaseRequisition {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  reqNo        String @map("req_no")
  fiscalYearId String @map("fiscal_year_id") @db.Uuid

  requestedOn   DateTime @map("requested_on") @db.Date
  justification String
  costCenterId  String?  @map("cost_center_id") @db.Uuid
  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(19, 4)
  currency      String   @db.Char(3)

  state RequisitionState @default(DRAFT)

  requestedById String    @map("requested_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz(6)
  decidedById   String?   @map("decided_by_id") @db.Uuid
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?   @map("decision_note")

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear  FiscalYear        @relation(fields: [fiscalYearId], references: [id])
  costCenter  CostCenter?       @relation("RequisitionCostCenter", fields: [costCenterId], references: [id])
  requestedBy User              @relation("RequisitionRequester", fields: [requestedById], references: [id])
  decidedBy   User?             @relation("RequisitionApprover", fields: [decidedById], references: [id])
  lines       RequisitionLine[]
  orders      PurchaseOrder[]

  @@unique([tenantId, reqNo])
  @@index([tenantId, state])
  @@map("purchase_requisitions")
}

model RequisitionLine {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  requisitionId String @map("requisition_id") @db.Uuid
  lineNo        Int    @map("line_no")
  description   String

  accountId    String  @map("account_id") @db.Uuid
  costCenterId String? @map("cost_center_id") @db.Uuid

  quantity  Decimal @db.Decimal(19, 4)
  unitPrice Decimal @map("unit_price") @db.Decimal(19, 4)
  amount    Decimal @db.Decimal(19, 4)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  account     Account             @relation("RequisitionLineAccount", fields: [accountId], references: [id])
  costCenter  CostCenter?         @relation("RequisitionLineCostCenter", fields: [costCenterId], references: [id])

  @@unique([requisitionId, lineNo])
  @@index([tenantId, requisitionId])
  @@map("requisition_lines")
}

model PurchaseOrder {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  poNo          String  @map("po_no")
  fiscalYearId  String  @map("fiscal_year_id") @db.Uuid
  vendorId      String  @map("vendor_id") @db.Uuid
  requisitionId String? @map("requisition_id") @db.Uuid

  orderDate    DateTime  @map("order_date") @db.Date
  expectedDate DateTime? @map("expected_date") @db.Date
  currency     String    @db.Char(3)
  terms        String?
  totalAmount  Decimal   @default(0) @map("total_amount") @db.Decimal(19, 4)

  state PurchaseOrderState @default(DRAFT)

  createdById   String    @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz(6)
  approvedById  String?   @map("approved_by_id") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)
  decisionNote  String?   @map("decision_note")
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(6)
  closureReason String?   @map("closure_reason")

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear  FiscalYear           @relation(fields: [fiscalYearId], references: [id])
  vendor      Vendor               @relation(fields: [vendorId], references: [id])
  requisition PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  createdBy   User                 @relation("OrderCreator", fields: [createdById], references: [id])
  approvedBy  User?                @relation("OrderApprover", fields: [approvedById], references: [id])

  lines        PurchaseOrderLine[]
  encumbrances Encumbrance[]
  receipts     GoodsReceipt[]
  invoices     VendorInvoice[]

  @@unique([tenantId, poNo])
  @@index([tenantId, vendorId, state])
  @@index([tenantId, state])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  lineNo          Int    @map("line_no")
  description     String

  accountId    String  @map("account_id") @db.Uuid
  costCenterId String? @map("cost_center_id") @db.Uuid

  quantity  Decimal @db.Decimal(19, 4)
  unitPrice Decimal @map("unit_price") @db.Decimal(19, 4)
  amount    Decimal @db.Decimal(19, 4)

  /// Cumulative quantities, maintained as receipts and invoices arrive. The
  /// three-way match compares these three numbers and nothing else.
  receivedQty Decimal @default(0) @map("received_qty") @db.Decimal(19, 4)
  invoicedQty Decimal @default(0) @map("invoiced_qty") @db.Decimal(19, 4)

  /// Resolved at approval, when the encumbrance is created. Null when no
  /// approved budget covers this account — which is allowed, and reported.
  budgetLineId String? @map("budget_line_id") @db.Uuid

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  account       Account             @relation("OrderLineAccount", fields: [accountId], references: [id])
  costCenter    CostCenter?         @relation("OrderLineCostCenter", fields: [costCenterId], references: [id])
  budgetLine    BudgetLine?         @relation(fields: [budgetLineId], references: [id])
  encumbrance   Encumbrance?
  receiptLines  GoodsReceiptLine[]
  invoiceLines  VendorInvoiceLine[]

  @@unique([purchaseOrderId, lineNo])
  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_lines")
}

/// Goods or services actually received (SRS REQ-PRC-02).
///
/// This is where the expense is recognised, not at payment:
///
///     DR  Expense / Asset            what arrived
///       CR  Goods Received Not Invoiced   the obligation it created
///
/// and the matching encumbrance is released by the same amount, because a
/// commitment that has become an actual must stop being counted as both.
model GoodsReceipt {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  grnNo           String @map("grn_no")
  purchaseOrderId String @map("purchase_order_id") @db.Uuid

  receivedOn  DateTime @map("received_on") @db.Date
  note        String?
  totalAmount Decimal  @map("total_amount") @db.Decimal(19, 4)

  /// The accrual voucher. Not nullable: a receipt that did not post is a
  /// receipt nobody can find in the ledger.
  postedHeaderId String @unique @map("posted_header_id") @db.Uuid

  receivedById String   @map("received_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder    PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedBy       User                  @relation("ReceiptReceiver", fields: [receivedById], references: [id])
  posting          TransactionHeader     @relation("GoodsReceiptPosting", fields: [postedHeaderId], references: [id])
  lines            GoodsReceiptLine[]
  encumbranceMoves EncumbranceMovement[]

  @@unique([tenantId, grnNo])
  @@index([tenantId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  goodsReceiptId String  @map("goods_receipt_id") @db.Uuid
  poLineId       String  @map("po_line_id") @db.Uuid
  quantity       Decimal @db.Decimal(19, 4)
  amount         Decimal @db.Decimal(19, 4)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  goodsReceipt GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  poLine       PurchaseOrderLine @relation(fields: [poLineId], references: [id])

  @@index([tenantId, goodsReceiptId])
  @@map("goods_receipt_lines")
}

/// A vendor's bill (SRS REQ-PRC-04).
///
///     DR  Goods Received Not Invoiced   what we already recognised
///       CR  Vendor AP                     what we now formally owe
///
/// so the expense keeps the date it was incurred and the payable appears when
/// the bill does.
model VendorInvoice {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  /// Ours.
  internalNo      String @map("internal_no")
  /// Theirs. Unique per vendor — paying the same invoice twice is the most
  /// common single loss in accounts payable, and it is nearly always a
  /// duplicate entry rather than a fraud.
  vendorInvoiceNo String @map("vendor_invoice_no")

  vendorId        String  @map("vendor_id") @db.Uuid
  purchaseOrderId String? @map("purchase_order_id") @db.Uuid

  invoiceDate   DateTime @map("invoice_date") @db.Date
  dueDate       DateTime @map("due_date") @db.Date
  currency      String   @db.Char(3)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(19, 4)
  /// Maintained as payment vouchers allocate against it.
  settledAmount Decimal  @default(0) @map("settled_amount") @db.Decimal(19, 4)

  state      VendorInvoiceState @default(MATCHED)
  /// Why the three-way match refused it, in the words the AP clerk will read.
  holdReason String?            @map("hold_reason")

  postedHeaderId String? @unique @map("posted_header_id") @db.Uuid

  createdById  String    @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)

  cancelledAt          DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationHeaderId String?   @unique @map("cancellation_header_id") @db.Uuid
  cancellationReason   String?   @map("cancellation_reason")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor        Vendor              @relation(fields: [vendorId], references: [id])
  purchaseOrder PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  createdBy     User                @relation("InvoiceCreator", fields: [createdById], references: [id])
  approvedBy    User?               @relation("InvoiceApprover", fields: [approvedById], references: [id])
  posting       TransactionHeader?  @relation("InvoicePosting", fields: [postedHeaderId], references: [id])
  cancellation  TransactionHeader?  @relation("InvoiceCancellationPosting", fields: [cancellationHeaderId], references: [id])
  lines         VendorInvoiceLine[]
  allocations   PaymentAllocation[]

  @@unique([tenantId, internalNo])
  @@unique([tenantId, vendorId, vendorInvoiceNo])
  @@index([tenantId, state, dueDate])
  @@index([tenantId, vendorId])
  @@map("vendor_invoices")
}

model VendorInvoiceLine {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  invoiceId   String @map("invoice_id") @db.Uuid
  lineNo      Int    @map("line_no")
  description String

  /// Null on a non-PO invoice — a utility bill has no purchase order, and
  /// forcing one would mean inventing orders nobody placed.
  poLineId     String? @map("po_line_id") @db.Uuid
  accountId    String  @map("account_id") @db.Uuid
  costCenterId String? @map("cost_center_id") @db.Uuid

  quantity  Decimal @db.Decimal(19, 4)
  unitPrice Decimal @map("unit_price") @db.Decimal(19, 4)
  amount    Decimal @db.Decimal(19, 4)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice    VendorInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  poLine     PurchaseOrderLine? @relation(fields: [poLineId], references: [id])
  account    Account            @relation("InvoiceLineAccount", fields: [accountId], references: [id])
  costCenter CostCenter?        @relation("InvoiceLineCostCenter", fields: [costCenterId], references: [id])

  @@unique([invoiceId, lineNo])
  @@index([tenantId, invoiceId])
  @@map("vendor_invoice_lines")
}

/// Money going out (SRS REQ-PRC-05).
///
///     DR  Vendor AP           the payable being cleared
///       CR  Cash / Bank         where it came from
///
/// The legacy `frmMakePayBill` posted expense straight against cash with no
/// payable in between, so there was never a moment at which the institution
/// could say what it owed.
model PaymentVoucher {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  pvNo     String @map("pv_no")
  vendorId String @map("vendor_id") @db.Uuid

  paymentDate   DateTime       @map("payment_date") @db.Date
  channel       PaymentChannel
  /// The cash or bank account the money leaves.
  bankAccountId String         @map("bank_account_id") @db.Uuid
  chequeNo      String?        @map("cheque_no")
  reference     String?

  currency String  @db.Char(3)
  amount   Decimal @db.Decimal(19, 4)

  state PaymentVoucherState @default(DRAFT)

  postedHeaderId String? @unique @map("posted_header_id") @db.Uuid

  createdById  String    @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  submittedAt  DateTime? @map("submitted_at") @db.Timestamptz(6)
  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  decisionNote String?   @map("decision_note")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor      Vendor              @relation(fields: [vendorId], references: [id])
  bankAccount Account             @relation("PaymentBankAccount", fields: [bankAccountId], references: [id])
  createdBy   User                @relation("PaymentCreator", fields: [createdById], references: [id])
  approvedBy  User?               @relation("PaymentApprover", fields: [approvedById], references: [id])
  posting     TransactionHeader?  @relation("PaymentPosting", fields: [postedHeaderId], references: [id])
  allocations PaymentAllocation[]

  @@unique([tenantId, pvNo])
  @@index([tenantId, vendorId, state])
  @@map("payment_vouchers")
}

model PaymentAllocation {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  paymentVoucherId String  @map("payment_voucher_id") @db.Uuid
  invoiceId        String  @map("invoice_id") @db.Uuid
  amount           Decimal @db.Decimal(19, 4)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment PaymentVoucher @relation(fields: [paymentVoucherId], references: [id], onDelete: Cascade)
  invoice VendorInvoice  @relation(fields: [invoiceId], references: [id])

  @@unique([paymentVoucherId, invoiceId])
  @@index([tenantId, invoiceId])
  @@map("payment_allocations")
}

// ---------------------------------------------------------------------------
// Academic structure and the fee matrix (SRS Module 2, Track B1)
//
// The legacy structure was three text columns discovered by SELECT DISTINCT:
// `Programs.ProgramName`, `AcademicYear.Batch`, and a `Colleges` string copied
// onto every row that referenced it. Identity was the name, so renaming a
// faculty orphaned everything pointing at it — the same disease as the chart
// of accounts before A1.
// ---------------------------------------------------------------------------

enum DegreeLevel {
  DIPLOMA
  BACHELOR
  MASTER
  PHD
}

enum TermKind {
  FALL
  SPRING
  SUMMER
}

enum AcademicPeriodStatus {
  PLANNED
  ACTIVE
  CLOSED
}

/// Which fee column a student falls in by where they are from. Kept separate
/// from `Nationality` because a fee matrix is priced on the category, not on
/// the country: an institution charges one expatriate rate, not one per state.
enum NationalityCategory {
  NATIONAL
  ARAB
  FOREIGN
}

enum FeeScheduleStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

model Faculty {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  nameAr   String @map("name_ar")
  nameEn   String @map("name_en")
  /// Where this faculty's costs and revenue land. The tuition account in the
  /// shipped chart requires a cost centre, and the faculty is the answer.
  costCenterId String? @map("cost_center_id") @db.Uuid
  isActive     Boolean @default(true) @map("is_active")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  costCenter  CostCenter?  @relation("FacultyCostCentre", fields: [costCenterId], references: [id])
  departments Department[]
  programmes  Programme[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("faculties")
}

model Department {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  facultyId String  @map("faculty_id") @db.Uuid
  code      String
  nameAr    String  @map("name_ar")
  nameEn    String  @map("name_en")
  isActive  Boolean @default(true) @map("is_active")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  faculty    Faculty     @relation(fields: [facultyId], references: [id])
  programmes Programme[]

  @@unique([tenantId, code])
  @@index([tenantId, facultyId])
  @@map("departments")
}

model Programme {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  facultyId    String  @map("faculty_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  code         String
  nameAr       String  @map("name_ar")
  nameEn       String  @map("name_en")

  degreeLevel DegreeLevel @map("degree_level")
  /// Standard duration. Both are held because a fee matrix prices per term
  /// while an admission offer is written in years, and deriving one from the
  /// other assumes a term count that summer intakes break.
  durationYears   Int     @map("duration_years")
  durationTerms   Int     @map("duration_terms")
  creditsRequired Int?    @map("credits_required")
  isActive        Boolean @default(true) @map("is_active")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  faculty      Faculty       @relation(fields: [facultyId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  feeSchedules FeeSchedule[]
  students     Student[]

  seatQuotas        SeatQuota[]
  eligibilityRules  EligibilityRule[]
  applicationChoice ApplicationChoice[]
  admissionOffers   AdmissionOffer[]

  @@unique([tenantId, code])
  @@index([tenantId, facultyId, isActive])
  @@map("programmes")
}

/// An academic year (2026/2027) and the terms inside it.
///
/// Deliberately NOT the fiscal year: an academic year usually straddles two of
/// them, and conflating the two is how a September intake's revenue lands in
/// the wrong set of accounts. The legacy `AcademicYear` table held neither —
/// it held a `Batch` text column, and the year itself existed nowhere.
model AcademicYear {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  code      String
  nameAr    String               @map("name_ar")
  nameEn    String               @map("name_en")
  startDate DateTime             @map("start_date") @db.Date
  endDate   DateTime             @map("end_date") @db.Date
  status    AcademicPeriodStatus @default(PLANNED)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms  AcademicTerm[]

  @@unique([tenantId, code])
  @@index([tenantId, startDate])
  @@map("academic_years")
}

model AcademicTerm {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  seq            Int
  kind           TermKind
  nameAr         String   @map("name_ar")
  nameEn         String   @map("name_en")
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  /// Last day a student may register for this term without an override.
  registrationClosesOn DateTime?            @map("registration_closes_on") @db.Date
  status               AcademicPeriodStatus @default(PLANNED)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, seq])
  @@index([tenantId, startDate, endDate])
  @@map("academic_terms")
}

/// An intake cohort — "the 2026 batch". A student belongs to one for life, and
/// it is a dimension of the fee matrix: what a cohort was admitted on is what
/// it pays, so raising next year's fees must not reprice this year's students.
model Batch {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  code          String
  nameAr        String  @map("name_ar")
  nameEn        String  @map("name_en")
  admissionYear Int     @map("admission_year")
  isActive      Boolean @default(true) @map("is_active")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeSchedules FeeSchedule[]
  students     Student[]
  seatQuotas   SeatQuota[]
  applications Application[]

  @@unique([tenantId, code])
  @@index([tenantId, admissionYear])
  @@map("batches")
}

/// The channel a student was admitted through — General, Private, Foreign,
/// Staff Child (SRS REQ-AC-05). A table rather than an enum: institutions
/// invent categories, and an enum change is a migration.
model AdmissionCategory {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  code      String
  nameAr    String  @map("name_ar")
  nameEn    String  @map("name_en")
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeSchedules FeeSchedule[]
  students     Student[]
  seatQuotas   SeatQuota[]
  applications Application[]

  @@unique([tenantId, code])
  @@map("admission_categories")
}

model Nationality {
  id       String              @id @default(uuid()) @db.Uuid
  tenantId String              @map("tenant_id") @db.Uuid
  code     String
  nameAr   String              @map("name_ar")
  nameEn   String              @map("name_en")
  category NationalityCategory @default(FOREIGN)
  isActive Boolean             @default(true) @map("is_active")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students     Student[]
  applications Application[]

  @@unique([tenantId, code])
  @@index([tenantId, category])
  @@map("nationalities")
}

/// A versioned, effective-dated fee schedule (SRS REQ-AC-04).
///
/// The legacy screen's save was `DELETE FROM TuitionFees WHERE Batch=@Batch`
/// followed by re-inserting the grid. The grid held one college and one
/// admission type; the DELETE named neither. Saving Medicine's General fees
/// therefore destroyed Pharmacy's, Dentistry's and every other type's for that
/// batch, silently, on an autocommit connection with no transaction. There
/// were exactly two fee columns, TuitionFees and RegFees, both Double.
///
/// Here a schedule is never edited. A revision is a new version; the previous
/// one is stamped SUPERSEDED, keeps its effective range, and stays attached to
/// every registration raised under it. An exclusion constraint refuses two
/// APPROVED versions whose effective ranges overlap on the same key, so
/// "what did this cohort owe in March" always has exactly one answer.
model FeeSchedule {
  id                  String @id @default(uuid()) @db.Uuid
  tenantId            String @map("tenant_id") @db.Uuid
  programmeId         String @map("programme_id") @db.Uuid
  batchId             String @map("batch_id") @db.Uuid
  admissionCategoryId String @map("admission_category_id") @db.Uuid

  /// Null means "any nationality category" — the fallback row. A schedule
  /// naming a category wins over it; see the resolution order in fee-matrix.ts.
  nationalityCategory NationalityCategory? @map("nationality_category")

  currency  String @db.Char(3)
  versionNo Int    @map("version_no")

  effectiveFrom DateTime  @map("effective_from") @db.Date
  /// Null is an open-ended range. Set when a later version supersedes this one.
  effectiveTo   DateTime? @map("effective_to") @db.Date

  status FeeScheduleStatus @default(DRAFT)

  preparedById String    @map("prepared_by_id") @db.Uuid
  preparedAt   DateTime  @default(now()) @map("prepared_at") @db.Timestamptz(6)
  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)
  note         String?

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programme         Programme         @relation(fields: [programmeId], references: [id])
  batch             Batch             @relation(fields: [batchId], references: [id])
  admissionCategory AdmissionCategory @relation(fields: [admissionCategoryId], references: [id])
  preparedBy        User              @relation("FeeSchedulePreparer", fields: [preparedById], references: [id])
  approvedBy        User?             @relation("FeeScheduleApprover", fields: [approvedById], references: [id])
  lines             FeeScheduleLine[]

  @@unique([tenantId, programmeId, batchId, admissionCategoryId, nationalityCategory, versionNo])
  @@index([tenantId, programmeId, batchId, status])
  @@map("fee_schedules")
}

model FeeScheduleLine {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  feeScheduleId String @map("fee_schedule_id") @db.Uuid
  feeItemId     String @map("fee_item_id") @db.Uuid

  amount Decimal @db.Decimal(19, 4)
  /// A mandatory item is billed on every registration under this schedule. An
  /// optional one (hostel, transport) is billed only when the student takes it.
  isMandatory Boolean @default(true) @map("is_mandatory")
  /// Overrides the fee item's own recurrence for this schedule only — a
  /// programme may charge a one-off where the catalogue says per-term.
  recurrence FeeRecurrence?
  sortOrder  Int            @default(0) @map("sort_order")
  note       String?

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeSchedule FeeSchedule @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)
  feeItem     FeeItem     @relation(fields: [feeItemId], references: [id])

  @@unique([feeScheduleId, feeItemId])
  @@index([tenantId, feeItemId])
  @@map("fee_schedule_lines")
}

// ---------------------------------------------------------------------------
// Admissions: capacity, eligibility, committee workflow (SRS Module 17, B2)
//
// The legacy seat-quota screen existed only in the Ribat/UOT build, held one
// row per COLLEGE (no programme, no admission channel), and saved with
// `Delete From StudentsVacants Where College=N'..'` followed by an insert
// naming college AND batch — so setting one batch's quota deleted every other
// batch's for that college. Capacity was never checked when a place was
// offered: `ViewStudVacants` counted students who had *paid*, from receipt
// vouchers, after the fact.
// ---------------------------------------------------------------------------

enum ApplicationState {
  DRAFT
  SUBMITTED
  /// Screened against the programme rules; awaiting a committee.
  UNDER_REVIEW
  OFFERED
  WAITLISTED
  REJECTED
  WITHDRAWN
  /// Offer accepted and a student record created.
  ENROLLED
}

/// A committee's verdict (REQ-ADM-CAP-03). Distinct from `ApplicationState`:
/// the decision is what the committee said, the state is where the application
/// has got to. A CONDITIONAL_ACCEPT that lapses ends REJECTED without anyone
/// rewriting what the committee decided.
enum AdmissionDecision {
  ACCEPT
  CONDITIONAL_ACCEPT
  WAITLIST
  REJECT
}

enum OfferState {
  ISSUED
  ACCEPTED
  DECLINED
  /// Deadline passed with no answer. Set by the lapse batch, never by hand.
  LAPSED
  /// Pulled by the institution before the deadline.
  WITHDRAWN
}

enum EligibilityOutcome {
  NOT_ASSESSED
  PASS
  /// Fails a rule but may still be considered — the committee is told which.
  FAIL
}

/// The school-leaving qualification an applicant holds. A per-tenant table
/// rather than an enum for the same reason admission categories are: an
/// institution recognises whatever certificates its applicants actually bring,
/// and adding one must not be a migration.
model CertificateType {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  code      String
  nameAr    String  @map("name_ar")
  nameEn    String  @map("name_en")
  /// The mark the certificate is reported out of, so scores from different
  /// systems can be compared. Sudanese secondary is out of 100 as a
  /// percentage; some are out of 700 or 1600.
  maxScore  Decimal @map("max_score") @db.Decimal(9, 3)
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules        EligibilityRule[]
  applications Application[]

  @@unique([tenantId, code])
  @@map("certificate_types")
}

/// Seats available for one programme × batch × admission category
/// (REQ-ADM-CAP-01).
///
/// Three dimensions, where the legacy table had one and a half. The counters
/// are NOT stored: `offered` and `confirmed` are counted from the offers
/// themselves under a row lock on this record, so the number of seats taken
/// cannot drift from the offers that took them. A stored counter is a second
/// record of the same fact, and the whole legacy audit is a catalogue of what
/// happens to those.
model SeatQuota {
  id                  String @id @default(uuid()) @db.Uuid
  tenantId            String @map("tenant_id") @db.Uuid
  programmeId         String @map("programme_id") @db.Uuid
  batchId             String @map("batch_id") @db.Uuid
  admissionCategoryId String @map("admission_category_id") @db.Uuid

  seats Int
  /// Seats held back from the general allocation — a ministry allocation, a
  /// scholarship block. Offers may not consume them without an override.
  reservedSeats Int @default(0) @map("reserved_seats")

  /// When false, an offer beyond capacity is refused outright. When true it is
  /// allowed with a recorded reason and a named approver.
  allowOverride Boolean @default(true) @map("allow_override")
  isActive      Boolean @default(true) @map("is_active")

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programme         Programme         @relation(fields: [programmeId], references: [id])
  batch             Batch             @relation(fields: [batchId], references: [id])
  admissionCategory AdmissionCategory @relation(fields: [admissionCategoryId], references: [id])
  createdBy         User              @relation("SeatQuotaCreator", fields: [createdById], references: [id])
  offers            AdmissionOffer[]

  @@unique([tenantId, programmeId, batchId, admissionCategoryId])
  @@index([tenantId, batchId])
  @@map("seat_quotas")
}

/// A screening rule for one programme (REQ-ADM-CAP-02).
///
/// Several rules may apply to one programme — one per certificate type it
/// accepts. An applicant holding a certificate no rule mentions is reported as
/// unassessable rather than silently passed.
model EligibilityRule {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  programmeId       String @map("programme_id") @db.Uuid
  certificateTypeId String @map("certificate_type_id") @db.Uuid

  /// Minimum overall percentage, normalised against the certificate's own
  /// maximum so a 700-scale and a 100-scale certificate compare.
  minPercentage Decimal @map("min_percentage") @db.Decimal(6, 3)
  /// Subjects the applicant must have sat. Compared case- and
  /// whitespace-insensitively against the subjects declared on the application.
  requiredSubjects String[] @map("required_subjects")
  minAge           Int?     @map("min_age")
  maxAge           Int?     @map("max_age")
  /// Restrict the rule to one nationality category, or null for all.
  nationalityCategory NationalityCategory? @map("nationality_category")

  isActive Boolean @default(true) @map("is_active")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programme       Programme       @relation(fields: [programmeId], references: [id])
  certificateType CertificateType @relation(fields: [certificateTypeId], references: [id])

  @@unique([tenantId, programmeId, certificateTypeId])
  @@index([tenantId, programmeId])
  @@map("eligibility_rules")
}

/// One person applying in one intake.
///
/// Deliberately not a `Student` row with status APPLICANT. A rejected applicant
/// must not consume a student number or appear in student reporting, and the
/// same person may apply in successive years. The Student record is created at
/// the moment an offer is accepted, and not before.
model Application {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  applicationNo String @map("application_no")

  batchId             String @map("batch_id") @db.Uuid
  admissionCategoryId String @map("admission_category_id") @db.Uuid

  fullNameAr String @map("full_name_ar")
  fullNameEn String @map("full_name_en")
  /// Alef/hamza/taa-marbuta-normalised, for duplicate detection. Written by
  /// the application, never by hand.
  searchKey  String @map("search_key")

  nationalId    String?   @map("national_id")
  passportNo    String?   @map("passport_no")
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  nationalityId String?   @map("nationality_id") @db.Uuid
  email         String?
  phone         String?

  certificateTypeId String?  @map("certificate_type_id") @db.Uuid
  certificateScore  Decimal? @map("certificate_score") @db.Decimal(9, 3)
  certificateYear   Int?     @map("certificate_year")
  /// Subjects sat, as declared. Screened against the rule's requirements.
  subjects          String[]

  state ApplicationState @default(DRAFT)

  /// The committee's verdict and its rationale (REQ-ADM-CAP-03).
  decision       AdmissionDecision?
  decisionNote   String?            @map("decision_note")
  decidedById    String?            @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?          @map("decided_at") @db.Timestamptz(6)
  /// Committee score, on whatever model the institution configures. Held here
  /// rather than derived so a ranked list is reproducible after the fact.
  committeeScore Decimal?           @map("committee_score") @db.Decimal(9, 3)

  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set when an accepted offer produced a student record.
  studentId   String?   @unique @map("student_id") @db.Uuid

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch             Batch               @relation(fields: [batchId], references: [id])
  admissionCategory AdmissionCategory   @relation(fields: [admissionCategoryId], references: [id])
  nationality       Nationality?        @relation(fields: [nationalityId], references: [id])
  certificateType   CertificateType?    @relation(fields: [certificateTypeId], references: [id])
  decidedBy         User?               @relation("ApplicationDecider", fields: [decidedById], references: [id])
  student           Student?            @relation("ApplicationStudent", fields: [studentId], references: [id])
  choices           ApplicationChoice[]
  offers            AdmissionOffer[]

  @@unique([tenantId, applicationNo])
  @@index([tenantId, batchId, state])
  @@index([tenantId, searchKey])
  @@index([tenantId, nationalId])
  @@map("applications")
}

/// A programme an applicant asked for, and where it came in their ranking.
model ApplicationChoice {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  programmeId   String @map("programme_id") @db.Uuid
  /// 1 is the applicant's first choice.
  rank          Int

  /// Result of automatic screening against this programme's rules.
  eligibility     EligibilityOutcome @default(NOT_ASSESSED)
  /// Which rules failed, in a sentence per rule, so the committee sees the
  /// reason rather than only the verdict.
  eligibilityNotes String[]          @map("eligibility_notes")
  assessedAt      DateTime?          @map("assessed_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  programme   Programme   @relation(fields: [programmeId], references: [id])

  @@unique([applicationId, rank])
  @@unique([applicationId, programmeId])
  @@index([tenantId, programmeId, eligibility])
  @@map("application_choices")
}

/// A place offered, and what became of it (REQ-ADM-CAP-04).
///
/// A row per offer rather than columns on the application, so a lapsed offer
/// and the waitlist promotion that followed it are both still readable. The
/// question "who was offered this seat before it came to me" has an answer.
model AdmissionOffer {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  seatQuotaId   String @map("seat_quota_id") @db.Uuid
  programmeId   String @map("programme_id") @db.Uuid

  state OfferState @default(ISSUED)

  issuedById String   @map("issued_by_id") @db.Uuid
  issuedAt   DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  /// Last day the applicant may accept. After it the lapse batch closes the
  /// offer and frees the seat.
  acceptBy   DateTime @map("accept_by") @db.Date

  /// A conditional offer states what must still be satisfied.
  conditions String?

  depositRequired Decimal?  @map("deposit_required") @db.Decimal(19, 4)
  depositPaidAt   DateTime? @map("deposit_paid_at") @db.Timestamptz(6)
  /// The receipt that paid the seat deposit, if one was taken.
  depositReceiptId String?  @map("deposit_receipt_id") @db.Uuid

  respondedAt DateTime? @map("responded_at") @db.Timestamptz(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)
  closeReason String?   @map("close_reason")

  /// Set when this offer was issued beyond the quota. Both the reason and the
  /// person are required — an override with neither is indistinguishable from
  /// a capacity check that was never run.
  overrodeCapacity Boolean @default(false) @map("overrode_capacity")
  overrideReason   String? @map("override_reason")
  overriddenById   String? @map("overridden_by_id") @db.Uuid

  /// Set when this offer filled a seat freed by an earlier one lapsing.
  promotedFromId String? @map("promoted_from_id") @db.Uuid

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  seatQuota     SeatQuota       @relation(fields: [seatQuotaId], references: [id])
  programme     Programme       @relation(fields: [programmeId], references: [id])
  issuedBy      User            @relation("OfferIssuer", fields: [issuedById], references: [id])
  overriddenBy  User?           @relation("OfferOverrider", fields: [overriddenById], references: [id])
  promotedFrom  AdmissionOffer? @relation("OfferPromotion", fields: [promotedFromId], references: [id])
  promotedTo    AdmissionOffer[] @relation("OfferPromotion")
  depositReceipt StudentReceipt? @relation("OfferDepositReceipt", fields: [depositReceiptId], references: [id])

  @@index([tenantId, seatQuotaId, state])
  @@index([tenantId, state, acceptBy])
  @@map("admission_offers")
}
