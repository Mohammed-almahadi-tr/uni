{
  "name": "uniflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && npm run db:roles && npm run db:sync-permissions && npm run db:check-roles && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "db:start": "tsx scripts/pg.ts start",
    "db:stop": "tsx scripts/pg.ts stop",
    "db:reset": "tsx scripts/pg.ts reset",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "generate": "prisma generate",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:roles": "node scripts/bootstrap-role.mjs",
    "db:sync-permissions": "tsx --conditions=react-server scripts/sync-permissions.ts",
    "db:check-roles": "node scripts/check-roles.mjs",
    "seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:buttons": "node scripts/press-buttons.mjs"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@17.10.0-beta.17": true,
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.9.1": true,
    "@swc/core@1.15.47": true,
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.9",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "next-intl": "^4.13.7",
    "otpauth": "^9.5.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
